aws_region = "us-east-1"
stack_id   = "augusta-nexa-dev" # -> landing bucket augusta-nexa-dev-providers-landing

# The map KEY is the S3 folder under the landing prefix
#   transacciones/empatia/transcripciones/detalle/<KEY>/...
# and endpoint_path is the LAST segment of the API URL. They are intentionally
# decoupled: the folder "BDO" routes to the "banco_occ" endpoint.
# Onboard a new endpoint by adding an entry here -- no Lambda change.
clients = {
  BDO = {
    api_base_url  = "https://nexa-empatia-staging.nexabpo.com/transcription/api/tipificaciones"
    endpoint_path = "banco_occ"
    enabled       = true
  }
  # BBOG = {
  #   api_base_url  = "https://nexa-empatia-staging.nexabpo.com/transcription/api/tipificaciones"
  #   endpoint_path = "banco_bogota"
  #   enabled       = true
  # }
}

# Do NOT commit real secrets. Prefer environment variables:
#   export TF_VAR_keycloak_config='{"token_url":"...","client_id":"...","client_secret":"..."}'
# keycloak_config = {
#   token_url     = "https://login-server-staging.nexabpo.com/auth/realms/nexa/protocol/openid-connect/token"
#   client_id     = "Connection.Apis.Auth"
#   client_secret = "REPLACE_ME"
# }
