aws_region = "us-east-2"
stack_id   = "augusta-nexa-dev" # -> landing bucket augusta-nexa-dev-providers-transit

# CMK that encrypts the client secrets (the "augusta-nexa-dev" key).
# kms_key_arn = "arn:aws:kms:us-east-2:575108921774:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# The map KEY is the S3 folder under the landing prefix
#   external/transacciones/empatia/transcripciones/<KEY>/year=.../...
# and also maps to the parameter/secret "<lower key>-detalle".
# URLs are split into host + path; endpoint_path / enpoint_cypher_path are the
# last URL segments. Credentials live in Secrets Manager (must exist before apply).
clients = {
  BDO = {
    token_url           = "https://login-server-staging.nexabpo.com"
    token_path          = "auth/realms/nexa/protocol/openid-connect/token"
    api_url             = "https://nexa-empatia-staging.nexabpo.com"
    api_path            = "transcription/api/tipificaciones"
    endpoint_path       = "banco_occ"
    enpoint_cypher_path = "bboc_encrip" # omit for clients without encrypted delivery
    enabled             = true
    # secret_name defaults to empatia/api/bdo-detalle (relative; stack prepended at runtime)
  }
  # BDB = {
  #   token_url           = "https://login-server-staging.nexabpo.com"
  #   token_path          = "auth/realms/nexa/protocol/openid-connect/token"
  #   api_url             = "https://nexa-empatia-staging.nexabpo.com"
  #   api_path            = "transcription/api/tipificaciones"
  #   endpoint_path       = "banco_bogota"
  #   enabled             = true
  # }
}
